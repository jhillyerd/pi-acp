{
  "name": "@jhillyerd/pi-acp",
  "version": "0.0.34",
  "description": "ACP adapter for pi coding agent (fork: wires ACP mcpServers to pi's built-in MCP)",
  "license": "MIT",
  "author": "Sergii Kozak <svkozak@gmail.com>",
  "contributors": [
    "James Hillyerd <james@hillyerd.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jhillyerd/pi-acp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/jhillyerd/pi-acp/issues"
  },
  "homepage": "https://github.com/jhillyerd/pi-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "pi-coding-agent",
    "adapter"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-acp-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "node scripts/smoke-acp.mjs",
    "smoke:mcp": "node scripts/smoke-acp-mcp.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.26.0",
    "cross-spawn": "^7.0.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.8.3",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
