{
  "name": "@jhillyerd/pi-acp",
  "version": "0.0.34",
  "description": "ACP adapter for pi coding agent (fork: wires ACP mcpServers to pi's built-in MCP)",
  "license": "MIT",
  "author": "Sergii Kozak <svkozak@gmail.com>",
  "contributors": [
    "James Hillyerd <james@hillyerd.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jhillyerd/pi-acp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/jhillyerd/pi-acp/issues"
  },
  "homepage": "https://github.com/jhillyerd/pi-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "pi-coding-agent",
    "adapter"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-acp-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "node scripts/smoke-acp.mjs",
    "smoke:mcp": "node scripts/smoke-acp-mcp.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "cross-spawn": "^7.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
